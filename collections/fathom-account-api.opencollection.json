{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fathom Analytics REST Account API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.usefathom.com/v1/account"
          },
          "docs": "Returns account information for the authenticated user."
        }
      ]
    }
  ],
  "bundled": true
}