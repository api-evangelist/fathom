          "name": "Get current visitors",
          "request": {
            "name": "Get current visitors",
            "description": {
              "content": "Returns the number of visitors currently on a site. Rate limited to 10 requests per minute.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "current_visitors"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "site_id",
                  "value": "<string>",
                  "description": "(Required) The site ID to query."
                },
                {
                  "disabled": false,
                  "key": "detailed",
                  "value": "<boolean>",
                  "description": "If true, returns breakdown by page and referrer."
                }
              ],
              "variable": []
