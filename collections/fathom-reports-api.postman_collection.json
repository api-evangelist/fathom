  "item": [
    {
      "id": "4cf12756-f94b-44e9-b9a0-c4ade74fa4fd",
      "name": "Reports",
      "description": {
        "content": "Aggregation reports and current visitor counts",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8e1eeb4d-c6f0-4e30-891e-289dd853951a",
          "name": "Get aggregations",
          "request": {
            "name": "Get aggregations",
            "description": {
              "content": "Returns aggregated analytics data. Rate limited to 10 requests per minute. Supports grouping by time period and dimension fields, sorting, filtering, and timezone-aware date ranges.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "aggregations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "entity",
                  "value": "<string>",
                  "description": "(Required) The entity type to aggregate."
                },
                {
                  "disabled": false,
                  "key": "entity_id",
                  "value": "<string>",
                  "description": "Required when entity is \"pageview\". The site ID."
                },
                {
                  "disabled": false,
                  "key": "site_id",
                  "value": "<string>",
                  "description": "Required when entity is \"event\". The site ID."
                },
                {
                  "disabled": false,
                  "key": "entity_name",
                  "value": "<string>",
                  "description": "Required when entity is \"event\". The event name."
                },
                {
                  "disabled": false,
                  "key": "aggregates",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of aggregate metrics. For pageviews: visits, uniques, pageviews, avg_duration, bounce_rate. For events: conversions, unique_conversions, value.\n"
                },
                {
                  "disabled": false,
                  "key": "date_grouping",
                  "value": "<string>",
                  "description": "Group results by time period."
                },
                {
                  "disabled": false,
                  "key": "field_grouping",
                  "value": "<string>",
                  "description": "Dimension field to group by. Allowed values: hostname, pathname, referrer_hostname, browser, country_code, city, device_type, operating_system, utm_source, utm_medium, utm_campaign, utm_content, utm_term, keyword.\n"
                },
                {
                  "disabled": false,
                  "key": "sort_by",
                  "value": "<string>",
                  "description": "Sort order in field:asc or field:desc format."
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "<string>",
                  "description": "IANA TZ database timezone name (e.g. America/New_York)."
                },
                {
                  "disabled": false,
                  "key": "date_from",
                  "value": "<integer>",
                  "description": "Start of date range as Unix timestamp."
                },
                {
                  "disabled": false,
                  "key": "date_to",
                  "value": "<integer>",
                  "description": "End of date range as Unix timestamp."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of results to return."
                },
                {
                  "disabled": false,
                  "key": "filters",
                  "value": "<string>",
                  "description": "JSON-encoded array of filter objects with field, operator (is, is not, is like, matching, not matching), and value keys.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
