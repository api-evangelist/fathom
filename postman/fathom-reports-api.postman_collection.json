            "url": {
              "raw": "{{baseUrl}}/aggregations?entity=event&entity_id=<string>&site_id=<string>&entity_name=<string>&aggregates=<string>&date_grouping=month&field_grouping=<string>&sort_by=<string>&timezone=<string>&date_from=<integer>&date_to=<integer>&limit=<integer>&filters=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "aggregations"
              ],
              "query": [
                {
                  "description": "(Required) The entity type to aggregate.",
                  "key": "entity",
                  "value": "event"
                },
                {
                  "description": "Required when entity is \"pageview\". The site ID.",
                  "key": "entity_id",
                  "value": "<string>"
